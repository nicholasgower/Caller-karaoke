[Desktop Entry]
Type=Application
Name=Caller Karaoke
Comment=Contra dance caller trainer
Exec=caller-karaoke
Icon=caller-karaoke
Terminal=false
Categories=AudioVideo;Audio;Education;
Keywords=contra;dance;caller;music;ABC;
# Lets the desktop hand the app a startup-notification token, so the window
# opens focused instead of behind the launcher under focus-stealing prevention.
StartupNotify=true
# winit derives WM_CLASS from the executable's file name, so the packaged
# binary (/usr/bin/caller-karaoke, or usr/bin/caller-karaoke inside the
# AppImage) reports this class. Renaming the executable means changing this
# value too, or the panel keeps a second, anonymous window entry.
StartupWMClass=caller-karaoke
